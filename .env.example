# Konfigurasi bot Doa Pagi.
# File ini TIDAK ikut ke git (.gitignore). Di Render ada dua pilihan:
#   1. Isi variable satu per satu di menu Environment, ATAU
#   2. Buat "Secret File" bernama .env berisi persis file ini.
# Variable dari dashboard Render selalu menang atas isi file ini.

# Meeting Zoom (dari undangan)
ZOOM_MEETING_ID=84694518277
ZOOM_PWD=BbSVbahz7XkjxRzOEPcfEAaH6TARku.1
ZOOM_PASSCODE=doapagi
ZOOM_DOMAIN=us06web.zoom.us

# Nama yang tampil di daftar peserta — GANTI sesuai nama di absensi
DISPLAY_NAME=Gopal

# Lama bertahan di meeting (menit)
DURATION_MIN=35

# ---------- Opsional ----------
# Uji coba: paksa join pada jam WIB ini di hari apa pun (hapus setelah tes!)
# DOA_TEST_AT=15:30

# Override URL self-ping (default sudah otomatis dari RENDER_EXTERNAL_URL)
# APP_URL=https://doa-pagi.onrender.com

# Interval self-ping & heartbeat (menit)
# PING_MINUTES=4
# HEARTBEAT_MINUTES=5
